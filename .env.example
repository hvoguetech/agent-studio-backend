# ROS — environment config. Copy to `.env` at the repo ROOT (gitignored) and set real values.
# All backend vars are prefixed ROS_. This file holds PLACEHOLDERS ONLY — never commit real secrets.

# --- Core ---
ROS_ENVIRONMENT=development            # "production" enforces the checklist at the bottom

# --- Platform auth ---
ROS_JWT_SECRET=dev-insecure-change-me  # MUST be a strong random value in production
# ROS_AUTH_REQUIRED=true               # default true — keep true so the service token is a real gate
ROS_BOOTSTRAP_ADMIN_EMAIL=you@ros.local
ROS_BOOTSTRAP_ADMIN_PASSWORD=ros-admin   # change for production

# --- Server-to-server barrier (an app backend → ROS) ---
# Static bearer that authenticates a trusted backend as a least-privilege service identity.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ROS_SERVICE_API_TOKEN=

# --- SSRF egress: allow specific private/loopback hosts (dev/testing only) ---
ROS_EGRESS_ALLOW_PRIVATE_HOSTS=[]      # e.g. ["localhost","127.0.0.1"]  (Docker: ["host.docker.internal"])

# --- Tools: per-environment values ---
# A JSON map exposed to REST/GraphQL tool + auth templates as {{env.*}}, so the SAME tool row
# resolves to a different host per deploy (dev/qa/prod). A template referencing a key NOT in this
# map fails the call loudly. Blank/unset = {}.
ROS_TOOL_VARS=                         # e.g. {"api_base":"https://api.example.com"}
# Deployment-wide fallback for a per-user auth provider's `token_ctx_key`: the run-context key an
# integration forwards its per-user token under (via X-ROS-Context) when a provider doesn't set
# its own. Empty = off. e.g. user_token
ROS_DEFAULT_TOKEN_CTX_KEY=

# --- Model (needed for live agent runs) ---
ROS_DEFAULT_MODEL=fake:echo            # offline-safe; set a real model for live runs, e.g. gpt-4.1-mini
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Agent workspaces ---
# Where a claude_code node / claude_agent tool works when it isn't pinned to a path: each run gets
# `<root>/<run id>`. Defaults into the data volume (apps/api/.data/workspaces, /app/.data/workspaces
# in Docker) so the files an agent writes OUTLIVE the run. Nothing prunes this - point it at a disk
# you are willing to grow, and reap old run dirs on your own schedule.
# ROS_WORKSPACE_ROOT=/app/.data/workspaces
# Pin EVERY agent on this process to one fixed cwd instead (overrides the per-run dir). Only safe
# where the process owns a single run - a VM/single-tenant host - since it is process-global.
# ROS_CLAUDE_CODE_WORKSPACE=

# --- Frontend ---
NEXT_PUBLIC_ROS_API_URL=http://localhost:8000

# ============================================================================
# PRODUCTION (Docker stack) — uncomment/set when deploying:
#   POSTGRES_PASSWORD=<db-password>          # compose substitutes this into the DB URL
#   ROS_DATABASE_URL=postgresql+psycopg://ros:<pw>@localhost:5432/ros
#   ROS_CHECKPOINT_BACKEND=postgres
#   ROS_REDIS_URL=redis://localhost:6379/0
# The app REFUSES to boot in production unless: strong ROS_JWT_SECRET,
# ROS_AUTH_REQUIRED=true, ROS_EGRESS_BLOCK_PRIVATE=true, Postgres ROS_DATABASE_URL.
# ============================================================================