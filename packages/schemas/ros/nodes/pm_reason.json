{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ros/nodes/pm_reason",
  "type": "object",
  "required": ["step"],
  "properties": {
    "step": {
      "type": "string",
      "enum": [
        "understand_context",
        "prioritize_unknowns",
        "gather_evidence",
        "update_beliefs",
        "decide_progress",
        "produce_work"
      ],
      "description": "Which stage of the PM reasoning loop this node is."
    },
    "objective": { "type": "string", "description": "understand_context: the objective (else inferred from the last user message)." },
    "unknowns": {
      "type": "array",
      "description": "Decision-relevant unknowns (understand/prioritize).",
      "items": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": { "type": "string" },
          "decision_impact": { "type": "string", "enum": ["low", "medium", "high"] },
          "blocking": { "type": "boolean" },
          "resolver": { "type": "string" },
          "ask_human": { "type": "boolean" }
        }
      }
    },
    "seed_claims": {
      "type": "array",
      "description": "Author/model-proposed claims to add (understand/gather). Confidence is calibrated at intake unless given.",
      "items": {
        "type": "object",
        "required": ["type", "statement"],
        "properties": {
          "type": { "type": "string", "enum": ["evidence", "assumption", "hypothesis", "recommendation"] },
          "statement": { "type": "string" },
          "source_type": { "type": "string", "enum": ["user", "document", "slack", "support", "analytics", "experiment", "agent_inference"] },
          "source_ref": { "type": "string" },
          "meta": { "type": "object", "description": "Structural signal, e.g. {\"n\": 837, \"p\": 0.31}." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "seed_edges": {
      "type": "array",
      "description": "Provenance edges between seeded claims, referenced by statement text.",
      "items": {
        "type": "object",
        "required": ["src", "dst", "relation"],
        "properties": {
          "src": { "type": "string" },
          "dst": { "type": "string" },
          "relation": { "type": "string", "enum": ["supported_by", "contradicted_by", "derived_from", "assumes"] },
          "weight": { "type": "number" }
        }
      }
    },
    "model": { "$ref": "ros/common#/$defs/ModelRef", "description": "Optional: model that proposes structure / writes the memo in a real deployment." },
    "prompt": { "$ref": "ros/common#/$defs/TemplateString", "x-ui": { "widget": "textarea" } }
  },
  "$comment": "ports: in:any, out:any (reads/writes the `beliefs` state field; emits belief_graph SSE frames)"
}
