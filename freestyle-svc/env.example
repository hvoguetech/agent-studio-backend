# ros-freestyle-svc environment.

# Freestyle API key (from dash.freestyle.sh). Lives ONLY in this service — never injected into a VM.
FREESTYLE_API_KEY=

# Shared secret ROS presents as `Authorization: Bearer <secret>`. MUST equal the backend's
# ROS_FREESTYLE_SERVICE_SECRET, and the backend's ROS_FREESTYLE_SERVICE_URL must point at this service.
FREESTYLE_SERVICE_SECRET=

# Port the service listens on (Railway sets PORT).
PORT=3000

# --- VM lifecycle policy (docs/GAPS.md G2) ---
# "persistent" (default) => the VM runs until an explicit DELETE /vm/:id. No idle-suspend/recycle.
# "sticky" => suspend-on-idle/resume-on-access. "ephemeral" => dies on idle.
ROS_VM_PERSISTENCE=persistent
# Idle timeout in seconds. 0 (default) => never auto-suspends (the persistent policy). Only meaningful
# for sticky/ephemeral.
ROS_VM_IDLE_TIMEOUT_SECONDS=0
ROS_VM_STICKY_PRIORITY=1

# Prebaked `ros-claude-backend` Freestyle snapshot with Python + the `ros` package (+ claude CLI/SDK)
# baked in, so the VM can run `python -m ros.runtime` immediately. Build it with `npm run build:image`
# (see below), then set the printed id here. Empty => a base python VM (runtime NOT pre-installed).
ROS_SNAPSHOT_ID=

# --- build:image only (bakes the ros-claude-backend snapshot) ---
# HTTPS clone URL for agent-studio-backend; may embed an x-access-token for a private clone, e.g.
#   https://x-access-token:<gh_token>@github.com/hvoguetech/agent-studio-backend.git
ROS_INSTALL_REPO_URL=
# Optional branch/tag to install (default: the repo's default branch).
ROS_INSTALL_REF=

# Per-exec launch timeout (ms). The runtime runs detached, so this only bounds the launch call.
ROS_VM_EXEC_TIMEOUT_MS=60000
