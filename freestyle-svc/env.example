# ros run-control service environment.

# Which execution provider backs the endpoints: "freestyle" (default) | "northflank". The HTTP
# contract is identical; ROS's ExecutionBackend is unaware of the choice.
EXECUTION_PROVIDER=freestyle

# Freestyle API key (from dash.freestyle.sh). Lives ONLY in this service — never injected into a VM.
# Required only when EXECUTION_PROVIDER=freestyle.
FREESTYLE_API_KEY=

# --- Northflank (required only when EXECUTION_PROVIDER=northflank) ---
# API token (Team/Org scoped) used to create/exec/delete run Services. Lives ONLY here.
NORTHFLANK_API_TOKEN=
# Project the run Services are created in.
NORTHFLANK_PROJECT_ID=
# How the run Service gets its image (pick ONE):
#  - INTERNAL build (recommended): the image built by a Northflank build/combined service in this
#    project (from run-image/Dockerfile). Set the build service id + branch + SHA ("latest" = newest).
NORTHFLANK_BUILD_SERVICE_ID=build-service
NORTHFLANK_BUILD_BRANCH=main
NORTHFLANK_BUILD_SHA=latest
#  - EXTERNAL image (fallback): a container-registry image path. Used only when
#    NORTHFLANK_BUILD_SERVICE_ID is unset.
NORTHFLANK_RUN_IMAGE=
# Optional region + compute plan for the run Service.
NORTHFLANK_REGION=
NORTHFLANK_PLAN=nf-compute-20
# Idle TTL (seconds) after which a warm run Service may be reaped. 0 = keep until explicit delete.
NORTHFLANK_IDLE_TTL_SECONDS=0

# Shared secret ROS presents as `Authorization: Bearer <secret>`. MUST equal the backend's
# ROS_FREESTYLE_SERVICE_SECRET, and the backend's ROS_FREESTYLE_SERVICE_URL must point at this service.
FREESTYLE_SERVICE_SECRET=

# Port the service listens on (Railway sets PORT).
PORT=3000

# --- VM lifecycle policy (docs/GAPS.md G2) ---
# "persistent" (default) => the VM runs until an explicit DELETE /vm/:id. No idle-suspend/recycle.
# "sticky" => suspend-on-idle/resume-on-access. "ephemeral" => dies on idle.
ROS_VM_PERSISTENCE=persistent
# Idle timeout in seconds. 0 (default) => never auto-suspends (the persistent policy). Only meaningful
# for sticky/ephemeral.
ROS_VM_IDLE_TIMEOUT_SECONDS=0
ROS_VM_STICKY_PRIORITY=1

# Prebaked `ros-claude-backend` Freestyle snapshot with Python + the `ros` package (+ claude CLI/SDK)
# baked in, so the VM can run `python -m ros.runtime` immediately. Build it with `npm run build:image`
# (see below), then set the printed id here. Empty => a base python VM (runtime NOT pre-installed).
ROS_SNAPSHOT_ID=

# --- build:image only (bakes the ros-claude-backend snapshot) ---
# Plain HTTPS clone URL for agent-studio-backend (no token in the URL), e.g.
#   https://github.com/hvoguetech/agent-studio-backend.git
ROS_INSTALL_REPO_URL=
# Token for a private clone. Kept separate from the URL; spliced in VM-side as an x-access-token so the
# token never lives in ROS_INSTALL_REPO_URL. Leave empty for a public repo. e.g. `gh auth token`.
ROS_INSTALL_TOKEN=
# Optional branch/tag to install (default: the repo's default branch).
ROS_INSTALL_REF=

# Per-exec launch timeout (ms). The runtime runs detached, so this only bounds the launch call.
ROS_VM_EXEC_TIMEOUT_MS=60000
